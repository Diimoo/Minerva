[Desktop Entry]
Type=Application
Name=Minerva
Comment=Lokaler sprachgesteuerter Assistent
# Platzhalter — install-autostart.sh ersetzt Exec durch den echten Projektpfad.
Exec=/path/to/Minerva/run.sh
Icon=audio-input-microphone
Terminal=false
Categories=Utility;
X-GNOME-Autostart-enabled=true
StartupNotify=false
