# MINERVA — Umgebungsvariablen (nach .env kopieren und anpassen).
# Alle Werte sind optional; ohne sie läuft Minerva vollständig lokal über Ollama.

# --- Anthropic-API (optional) ---------------------------------------------
# Wenn gesetzt, wählt brain.backend="auto" automatisch Anthropic (z. B. Opus).
# ANTHROPIC_API_KEY=sk-ant-...

# --- Konfig-Overrides per Env (Präfix MINERVA_) ---------------------------
# MINERVA_BRAIN_BACKEND=ollama          # auto | ollama | anthropic | claude_code
# MINERVA_BRAIN_MODEL=qwen3.5:9b
# MINERVA_BRAIN_ANTHROPIC_MODEL=claude-opus-4-8

# --- Claude über das Pro/Max-Abo (brain.backend=claude_code) ---------------
# Braucht keinen API-Key, aber eine eingerichtete `claude` CLI und das Extra
# `pip install -e ".[claude-code]"`. Leer lassen = Vorgabe der CLI übernehmen.
# MINERVA_BRAIN_CLAUDE_CODE_MODEL=
# MINERVA_BRAIN_CLAUDE_CODE_EFFORT=     # low | medium | high | xhigh | max
# MINERVA_SAFETY_MODE=yolo              # guarded | readonly | yolo
# MINERVA_VOICE_REQUIRE_WAKE_WORD=true
# MINERVA_VOICE_TTS_BACKEND=piper       # piper | higgs
# MINERVA_VOICE_STT_MODEL=small         # tiny|base|small|medium|large-v3

# --- Pfade (optional) -----------------------------------------------------
# MINERVA_HOME=~/.minerva
# MINERVA_PROJ_DIR=~/Proj
